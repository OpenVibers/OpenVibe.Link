<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app is backed up: the pairing and the session live in the Android Keystore, and a backup would
     carry ciphertext a restored phone cannot read. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
